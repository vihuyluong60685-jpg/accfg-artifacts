*.tgz

# Local secrets (sanitized templates may be tracked after review)
.env
.env.*
!.env.example
!.env.template
.secrets/
*.pem
*.key

# Temporary logs and large generated experiment data
*.log
*.logs
*.tmp
*.npy
*.npz
*.h5
*.hdf5
/artifacts/raw/
/artifacts/intermediate/
/artifacts/**/*.png
/reports/raw/
/reports/logs/

# Keep reports, configuration JSON, CSV summaries, and analysis scripts trackable.
# Parent ignore rules do not govern files inside independent submodule repositories.
